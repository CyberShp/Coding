[Unit]
Description=Observation Points Agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/OSM/coffer_data
ExecStartPre=/bin/mkdir -p /var/log/observation-points
ExecStart=/usr/bin/python3 -m observation_points -c /etc/observation-points/config.json --log-file /var/log/observation-points/agent.log
ExecReload=/bin/kill -HUP $MAINPID
Environment=PYTHONUNBUFFERED=1
Restart=always
RestartSec=10
StartLimitIntervalSec=300
StartLimitBurst=5
TimeoutStopSec=20

[Install]
WantedBy=multi-user.target
